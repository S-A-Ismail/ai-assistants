# Copy to .env and edit. Everything here is optional.

# Where model weights live (default N:\Models)
# STUDIO_MODELS_DIR=N:\Models

# Bind address. Keep 127.0.0.1 unless you set an API key below.
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8000

# When set, /api and /mcp require "X-API-Key: <key>" or "Authorization: Bearer <key>".
# STUDIO_API_KEY=

# A Hugging Face token makes model downloads faster (higher rate limits). Read-only is enough.
# HF_TOKEN=

# Set to 0 to keep auto-detected Hindi transcripts in Devanagari instead of re-decoding as Urdu.
# WHISPER_HINDI_AS_URDU=1
